# Select network: "testnet" or "mainnet"
GASFREE_NETWORK=testnet

# API credentials (provide both to switch networks without redeploying)
GASFREE_TESTNET_API_KEY=your_testnet_api_key
GASFREE_TESTNET_API_SECRET=your_testnet_api_secret
GASFREE_MAINNET_API_KEY=your_mainnet_api_key
GASFREE_MAINNET_API_SECRET=your_mainnet_api_secret

# Tron account used for gasless transfers
GASFREE_ADDRESS=the_tron_address_you_send_from
GASFREE_PRIVATE_KEY=the_private_key_for_that_address

# Express server port
PORT=4000
